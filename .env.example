PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/tinzel
# Only needed to copy the live admin into local MongoDB with npm run seed:local-admin.
ATLAS_MONGODB_URI=
FRONTEND_URL=http://localhost:5173
# Public API origin used in printer capability links.
BACKEND_URL=http://localhost:5001

# --- Google SMTP Email Delivery ---
# Generate an App Password in your Google Account Security settings (requires 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Tinzel <notifications@tinzel.com>"

# --- Twilio SMS & WhatsApp ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=
# DEFAULT_COUNTRY_CODE=255
# TWILIO_STATUS_CALLBACK_URL=
# ENABLE_TWILIO_SMS_FALLBACK=true

# --- NextSMS Transactional SMS ---
NEXTSMS_USERNAME=your_nextsms_username
NEXTSMS_PASSWORD=your_nextsms_password

# Originals use resumable 1 MiB parts in GridFS by default.
# Set to blob only after connecting a PRIVATE Vercel Blob store.
MEDIA_STORAGE=gridfs
BLOB_READ_WRITE_TOKEN=
MEDIA_MAX_FILE_BYTES=26214400
MEDIA_MAX_FILES=100
MEDIA_MAX_TOTAL_BYTES=1073741824
# Protects the production preview/archive worker invoked by Vercel cron.
CRON_SECRET=
# Explicitly enable after reviewing the recovery/retention policy.
MEDIA_CLEANUP_ENABLED=false
# Re-creatable folder archives expire after 24h; originals are unaffected.
MEDIA_ARCHIVE_TTL_HOURS=24

# Enable only after private-store and persistent-worker verification.
DRAFT_UPLOAD_PROVIDER=gridfs
DRAFT_BLOB_READ_WRITE_TOKEN=
PROOF_WORKER_MODE=dedicated
PROOF_PROCESS_COUNT=2
PROOF_PAGE_BUNDLE=true
